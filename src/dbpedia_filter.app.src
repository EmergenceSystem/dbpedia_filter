{application, dbpedia_filter, [
    {description, "em_filter example for Dbpedia. Default dbo is Company"},
    {vsn, "0.2.0"},
    {registered, [dbpedia_filter_sup, dbpedia_filter_server]},
    {mod, {dbpedia_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        dbpedia_filter_sup,
        dbpedia_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/dbpedia_filter"}]}
]}.
